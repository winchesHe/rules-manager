{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "composite": true,
    "declaration": true,
    "outDir": ".tsbuild",
    "types": ["node", "vite/client"]
  },
  "include": ["main", "preload", "renderer", "electron.vite.config.ts"]
}
